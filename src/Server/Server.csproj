<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Kusto.Data" Version="14.2.0" />
    <PackageReference Include="Microsoft.Azure.Kusto.Language" Version="12.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" Version="17.2.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StreamJsonRpc" Version="2.22.23" />
    <!-- Security pin for StreamJsonRpc's MessagePack dependency. Runtime assets are excluded because
         the server uses JsonMessageFormatter; only StreamJsonRpc's unused MessagePackFormatter loads them. -->
    <PackageReference Include="MessagePack" Version="2.5.303" ExcludeAssets="runtime" />
    <PackageReference Include="MessagePack.Annotations" Version="2.5.303" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
