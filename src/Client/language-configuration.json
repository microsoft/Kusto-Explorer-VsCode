{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "```", "close": "```", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["```", "```"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}]*|\\([^)]*|\\[[^\\]]*)$",
    "decreaseIndentPattern": "^\\s*[\\}\\)\\]].*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*//\\s*\\S.*$",
      "afterText": "^.*\\S.*$",
      "action": { "indent": "none", "appendText": "// " }
    }
  ]
}
